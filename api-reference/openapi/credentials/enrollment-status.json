{
  "paths": {
    "/credentials/enrollments/{enrollment_id}": {
      "get": {
        "operationId": "getCredentialEnrollment",
        "tags": [
          "Credenciales"
        ],
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "summary": "Estado del enrolamiento",
        "description": "Devuelve el estado del enrolamiento iniciado con POST /credentials. Se consulta hasta que `status` deja de ser `pending`: el login contra el SII demora del orden de 15 segundos, así que basta con consultar cada 2-3 segundos.",
        "parameters": [
          {
            "name": "enrollment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador devuelto por POST /credentials",
            "example": "cenr_3940730445066399260"
          }
        ],
        "responses": {
          "200": {
            "description": "Estado del enrolamiento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialEnrollment"
                },
                "example": {
                  "enrollment_id": "cenr_3940730445066399260",
                  "status": "valid",
                  "user_rut": "12345678-9",
                  "error": null,
                  "credential": {
                    "id": "cred_3940730445066399260",
                    "user": "12345678-9",
                    "status": "VALID"
                  },
                  "ws_channel": "cred-validation-129816",
                  "created_at": "2026-09-17T11:20:20.429990-03:00",
                  "finished_at": "2026-09-17T11:20:34.493000-03:00"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - API key inválida o faltante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Enrolamiento no encontrado o de una entidad sin acceso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CredentialEnrollment": {
        "type": "object",
        "properties": {
          "enrollment_id": {
            "type": "string",
            "description": "Identificador del enrolamiento",
            "example": "cenr_3940730445066399260"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "valid",
              "invalid",
              "error"
            ],
            "description": "pending: el login sigue en curso. valid: la credencial quedó enrolada. invalid: el SII rechazó la clave. error: no se pudo preguntarle al SII (reintentable).",
            "example": "pending"
          },
          "user_rut": {
            "type": "string",
            "description": "RUT de la credencial que se está enrolando",
            "example": "12345678-9"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Mensaje del SII cuando status es invalid o error",
            "example": null
          },
          "credential": {
            "type": "object",
            "nullable": true,
            "description": "La credencial creada; sólo viene cuando status es valid"
          },
          "ws_channel": {
            "type": "string",
            "description": "Canal WebSocket con el avance en vivo (lo usa el frontend)",
            "example": "cred-validation-129816"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  }
}
