{
  "paths": {
    "/folios": {
      "get": {
        "operationId": "listFolioAvailability",
        "tags": [
          "Folios"
        ],
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "summary": "Folios disponibles y timbrajes históricos",
        "description": "Última lectura conocida del estado de tus folios en el SII: cuántos tienes timbrados y sin emitir (`available`), cuántos te autoriza el SII por solicitud (`max_per_request`) y los rangos que te timbraron antes (`timbrajes`).\n\nEl dato vive en el SII y solo se conoce consultándolo, así que este endpoint responde con la **última foto guardada** y su fecha (`as_of`) — no bloquea. Para forzar una relectura usa `POST /folios/refresh`.\n\nSi la entidad nunca fue consultada, `results` viene vacío. Vacío significa *no sabemos*, no *cero folios*.",
        "parameters": [
          {
            "name": "master_entity_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID de la entidad maestra (opaco `eid_...` o entero).",
            "example": "eid_NDgyMTM6c2lnbmF0dXJl"
          },
          {
            "name": "dte_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Filtra por tipo de documento.",
            "example": 33
          }
        ],
        "responses": {
          "200": {
            "description": "Última foto conocida por tipo de documento",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FolioAvailability"
                      }
                    }
                  }
                },
                "example": {
                  "results": [
                    {
                      "dte_type": 33,
                      "available": 120,
                      "max_per_request": 50,
                      "last_timbraje": "2026-08-19",
                      "timbrajes": [
                        {
                          "authorization_date": "2026-08-19",
                          "quantity": 50,
                          "folio_start": 539,
                          "folio_end": 588,
                          "consistent": true
                        }
                      ],
                      "as_of": "2026-08-27T14:05:00Z"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Sin acceso a la entidad indicada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "example": "No tienes acceso a esta entidad."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
